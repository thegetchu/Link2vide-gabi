# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# REPLICATE_API_TOKEN: Replicate API token for Wan 3.0 video generation.
REPLICATE_API_TOKEN=""

# WAN_MODEL_VERSION: Model identifier or version for Wan 3.0 on Replicate (e.g. wan-video/wan-2.1-t2v-14b or wan-2.1-i2v-720p)
WAN_MODEL_VERSION="wan-video/wan-2.1-t2v-14b"

# JSON2VIDEO_API_KEY: JSON2Video API key for server-side video rendering.
JSON2VIDEO_API_KEY=""

# OPENAI_API_KEY: Optional external provider key
OPENAI_API_KEY=""
